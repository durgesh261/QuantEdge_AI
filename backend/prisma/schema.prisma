datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

model User {
  id              String   @id @default(uuid())
  displayName     String   @default("QuantEdge Trader") @map("display_name")
  themePreference String   @default("dark") @map("theme_preference")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model SystemSettings {
  id                    String   @id @default("default-settings")
  defaultCurrency       String   @default("USD") @map("default_currency")
  timezone              String   @default("Asia/Kolkata")
  maxStaleSignalSeconds Int      @default(60) @map("max_stale_signal_seconds")
  isKillSwitchActive    Boolean  @default(false) @map("is_kill_switch_active")
  executionMode         String   @default("PAPER") @map("execution_mode")
  deltaApiKey           String?  @map("delta_api_key")
  deltaApiSecret        String?  @map("delta_api_secret")
  deltaEnvironment      String   @default("PRODUCTION") @map("delta_environment")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model MarketCandle {
  id        String   @id @default(uuid())
  symbol    String
  timeframe String   @default("1H")
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  timestamp DateTime

  @@unique([symbol, timeframe, timestamp])
  @@index([symbol, timestamp])
  @@map("market_candles")
}

model MarketSnapshot {
  id           String   @id @default(uuid())
  symbol       String   @unique
  currentPrice Float    @map("current_price")
  spread       Float?
  session      String?
  trend        String?
  volatility   String?
  timestamp    DateTime @default(now())

  @@map("market_snapshots")
}

model MarketEvent {
  id          String   @id @default(uuid())
  symbol      String
  eventType   String   @map("event_type")
  payloadJson String   @map("payload_json")
  timestamp   DateTime @default(now())

  @@index([symbol, timestamp])
  @@map("market_events")
}

model OrderBlock {
  id           String   @id @default(uuid())
  symbol       String
  timeframe    String   @default("1H")
  type         String
  upperPrice   Float    @map("upper_price")
  lowerPrice   Float    @map("lower_price")
  source       String   @default("NATIVE_ENGINE")
  strength     Float
  width        Float
  widthPercent Float    @map("width_percent")
  freshness    Float    @default(100.0)
  touchCount   Int      @default(0) @map("touch_count")
  status       String   @default("FRESH")
  isTraded     Boolean  @default(false) @map("is_traded")
  isUsed       Boolean  @default(false) @map("is_used")
  canonicalId  String   @default("") @map("canonical_id")
  usedAt       DateTime? @map("used_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([symbol, status, isTraded])
  @@index([symbol, isUsed])
  @@index([canonicalId])
  @@index([symbol, timeframe, createdAt])
  @@map("order_blocks")
}

model CanonicalOrderBlock {
  id                  String   @id
  symbol              String
  timeframe           String   @default("1H")
  direction           String   // BULLISH | BEARISH
  sourceType          String   @map("source_type") // INTERNAL | SWING
  sourceBarTime       DateTime @map("source_bar_time")
  upperPrice          Float    @map("upper_price")
  lowerPrice          Float    @map("lower_price")
  createdAt           DateTime @default(now()) @map("created_at")
  createdFromStructure String  @default("BOS") @map("created_from_structure")
  structureType       String   @map("structure_type") // INTERNAL | SWING
  status              String   @default("ACTIVE") // ACTIVE | TOUCHED | TRADED | MITIGATED | MERGED
  mitigated           Boolean  @default(false)
  mitigatedAt         DateTime? @map("mitigated_at")
  touched             Boolean  @default(false)
  firstTouchTime      DateTime? @map("first_touch_time")
  firstTouchPrice     Float?    @map("first_touch_price")
  traded              Boolean  @default(false)
  lastUpdated         DateTime @updatedAt @map("last_updated")
  mergedZoneId        String?   @map("merged_zone_id")
  parsedBarHigh       Float     @map("parsed_bar_high")
  parsedBarLow        Float     @map("parsed_bar_low")
  baseCandleIndex     Int       @map("base_candle_index")
  breakCandleIndex    Int       @map("break_candle_index")

  @@index([symbol, status])
  @@index([symbol, direction, status])
  @@index([createdAt])
  @@map("canonical_order_blocks")
}

model StructureHistoryRecord {
  id          String   @id @default(uuid())
  symbol      String
  timeframe   String   @default("1H")
  eventType   String   @map("event_type")
  direction   String
  brokenLevel Float    @map("broken_level")
  isInternal  Boolean  @default(false) @map("is_internal")
  candleTime  DateTime @map("candle_time")
  detectedAt  DateTime @default(now()) @map("detected_at")

  @@index([symbol, timeframe, candleTime])
  @@map("structure_history_records")
}

model LiquiditySweepRecord {
  id         String   @id @default(uuid())
  symbol     String
  timeframe  String   @default("1H")
  sweepType  String   @map("sweep_type")
  level      Float
  candleTime DateTime @map("candle_time")
  detectedAt DateTime @default(now()) @map("detected_at")

  @@index([symbol, timeframe, candleTime])
  @@map("liquidity_sweep_records")
}

model StrategySignalRecord {
  id              String   @id @default(uuid())
  symbol          String
  timeframe       String   @default("1H")
  outcome         String
  price           Float
  stopLossPrice   Float?   @map("stop_loss_price")
  takeProfitPrice Float?   @map("take_profit_price")
  activeZoneId    String?  @map("active_zone_id")
  rationale       String
  confidenceScore Float    @map("confidence_score")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([symbol, timeframe, createdAt])
  @@map("strategy_signal_records")
}

model DecisionLog {
  id                String   @id @default(uuid())
  signalId          String   @map("signal_id")
  symbol            String
  timeframe         String   @default("1H")
  decisionState     String   @map("decision_state")
  outcome           String
  entryPrice        Float    @map("entry_price")
  stopLossPrice     Float    @map("stop_loss_price")
  takeProfitPrice   Float    @map("take_profit_price")
  positionSize      Float    @map("position_size")
  leverage          Float
  riskPercent       Float    @map("risk_percent")
  confidenceScore   Float    @map("confidence_score")
  reasonCodesJson   String   @map("reason_codes_json")
  inputSnapshotHash String   @map("input_snapshot_hash")
  timestamp         DateTime @default(now())

  @@index([symbol, decisionState, timestamp])
  @@map("decision_logs")
}

model DecisionExplanation {
  id              String   @id @default(uuid())
  decisionId      String   @unique @map("decision_id")
  symbol          String
  decisionState   String   @map("decision_state")
  confidenceScore Float    @map("confidence_score")
  shortSummary    String   @map("short_summary")
  mediumSummary   String   @map("medium_summary")
  detailedSummary String   @map("detailed_summary")
  timestamp       DateTime @default(now())

  @@index([symbol, decisionId])
  @@map("decision_explanations")
}

model DecisionTimeline {
  id            String   @id @default(uuid())
  explanationId String   @map("explanation_id")
  stepIndex     Int      @map("step_index")
  stage         String
  status        String
  description   String
  timestamp     DateTime @default(now())

  @@index([explanationId, stepIndex])
  @@map("decision_timelines")
}

model DecisionReason {
  id               String  @id @default(uuid())
  explanationId    String  @map("explanation_id")
  reasonCode       String  @map("reason_code")
  humanExplanation String  @map("human_explanation")
  isPassed         Boolean @default(true) @map("is_passed")

  @@index([explanationId])
  @@map("decision_reasons")
}

model ExchangeBalance {
  id               String   @id @default(uuid())
  assetSymbol      String   @map("asset_symbol")
  balance          Float    @default(0)
  availableBalance Float    @default(0) @map("available_balance")
  marginAmount     Float    @default(0) @map("margin_amount")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([assetSymbol])
  @@map("exchange_balances")
}

model ExchangePosition {
  id               String   @id @default(uuid())
  productSymbol    String   @map("product_symbol")
  side             String
  size             Float
  entryPrice       Float    @map("entry_price")
  markPrice        Float    @map("mark_price")
  liquidationPrice Float?   @map("liquidation_price")
  marginAmount     Float    @map("margin_amount")
  leverage         Float
  unrealizedPnl    Float    @default(0) @map("unrealized_pnl")
  realizedPnl      Float    @default(0) @map("realized_pnl")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([productSymbol])
  @@map("exchange_positions")
}

model ExchangeOrder {
  id            String   @id @default(uuid())
  orderId       String   @unique @map("order_id")
  clientOrderId String?  @map("client_order_id")
  productSymbol String   @map("product_symbol")
  side          String
  orderType     String   @map("order_type")
  size          Float
  price         Float?
  stopPrice     Float?   @map("stop_price")
  filledSize    Float    @default(0) @map("filled_size")
  state         String
  stopLoss      Float?   @map("stop_loss")
  takeProfit    Float?   @map("take_profit")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([productSymbol, state])
  @@map("exchange_orders")
}

model TradeLedger {
  id                  String    @id @default(uuid())
  tradeId             String    @unique @map("trade_id")
  exchangeOrderId     String    @map("exchange_order_id")
  exchangeTradeId     String?   @map("exchange_trade_id")
  symbol              String
  timeframe           String    @default("1H")
  strategyProfileId   String?   @map("strategy_profile_id")
  strategyVersion     String    @default("1.0.0") @map("strategy_version")
  indicatorVersion    String    @default("1.0.0") @map("indicator_version")
  ruleVersion         String    @default("1.0.0") @map("rule_version")
  decisionVersion     String    @default("1.0.0") @map("decision_version")
  executionMode       String    @map("execution_mode")
  side                String
  entryPrice          Float     @map("entry_price")
  exitPrice           Float?    @map("exit_price")
  quantity            Float
  marginUsed          Float     @map("margin_used")
  leverage            Float
  riskPercent         Float     @map("risk_percent")
  rewardPercent       Float?    @map("reward_percent")
  stopLoss            Float     @map("stop_loss")
  takeProfit          Float     @map("take_profit")
  grossPnL            Float?    @map("gross_pnl")
  tradingFee          Float?    @map("trading_fee")
  fundingFee          Float?    @map("funding_fee")
  tax                 Float?
  netPnL              Float?    @map("net_pnl")
  durationSeconds     Int?      @map("duration_seconds")
  executionLatencyMs  Float?    @map("execution_latency_ms")
  decisionConfidence  Float     @map("decision_confidence")
  decisionExplanation String    @map("decision_explanation")
  resultStatus        String    @map("result_status")
  syncStatus          String    @map("sync_status")
  executedAt          DateTime  @default(now()) @map("executed_at")
  closedAt            DateTime? @map("closed_at")

  @@map("trade_ledger")
}

model ScannerState {
  id            String   @id @default(cuid())
  isRunning     Boolean  @default(true)   // Global engine on/off
  isPaused      Boolean  @default(false)  // Global pause
  ticksTotal    Int      @default(0)
  signalsTotal  Int      @default(0)
  tradesTotal   Int      @default(0)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@map("scanner_state")
}

model ScannerPair {
  id              String   @id @default(cuid())
  symbol          String   @unique
  isActive        Boolean  @default(true)
  isPaused        Boolean  @default(false)
  status          String   @default("ENGINE") // ENGINE, PAUSED, STOPPED
  livePrice       Float    @default(0)
  priceChange24h  Float    @default(0)
  activeOBs       Int      @default(0)
  obWidthPct      Float?
  aiScore         Float?
  lastTickAt      DateTime @default(now())
  lastSignalAt    DateTime?
  ticksProcessed  Int      @default(0)
  signalsTriggered Int     @default(0)
  tradesExecuted  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([symbol])
  @@index([status])
  @@map("scanner_pairs")
}

model ScannerTick {
  id        String   @id @default(cuid())
  symbol    String
  price     Float
  source    String   @default("delta")
  timestamp DateTime @default(now())

  @@index([symbol, timestamp])
  @@map("scanner_ticks")
}

model ScannerSignal {
  id        String   @id @default(cuid())
  symbol    String
  type      String   // OB_DETECTED, BREAKOUT, MITIGATION, etc.
  aiScore   Float
  metadata  String?  // JSON
  createdAt DateTime @default(now())

  @@index([symbol, createdAt])
  @@map("scanner_signals")
}

model NewsArticle {
  id            String   @id @default(cuid())
  articleId     String   @unique @map("article_id")
  headline      String
  summary       String?
  url           String   @unique
  source        String
  category      String   // CRYPTO, BITCOIN, ETHEREUM, MACRO_ECONOMY, REGULATORY, MARKETS, TECH
  importance    String   @default("MEDIUM") // HIGH, MEDIUM, LOW
  sentiment     String?  // BULLISH, BEARISH, NEUTRAL
  impactScore   Int?     // 1-10
  symbols       String?  @map("symbols_json") // JSON array of affected symbols
  publishedAt   DateTime @map("published_at")
  receivedAt    DateTime @default(now()) @map("received_at")
  imageUrl      String?  @map("image_url")
  tickers       String?  @map("tickers_json")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([publishedAt, category])
  @@index([category, importance])
  @@index([receivedAt])
  @@map("news_articles")
}

model EconomicEvent {
  id              String   @id @default(cuid())
  eventId         String   @unique @map("event_id") // unique identifier from provider
  title           String
  country         String
  currency        String
  category        String   // INFLATION, EMPLOYMENT, GDP, RATES, PMI, RETAIL, TRADE, etc.
  importance      String   @default("MEDIUM") // HIGH, MEDIUM, LOW
  scheduledAt     DateTime @map("scheduled_at") // UTC
  timezone        String   @default("UTC") @map("timezone")
  previousValue   String?  @map("previous_value")
  forecastValue   String?  @map("forecast_value")
  actualValue     String?  @map("actual_value")
  unit            String?
  status          String   @default("UPCOMING") // UPCOMING, RELEASED
  source          String
  sourceUrl       String?  @map("source_url")
  releasedAt      DateTime? @map("released_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  expiresAt       DateTime? @map("expires_at") // for cleanup

  @@index([scheduledAt, status])
  @@index([country, currency])
  @@index([category, importance])
  @@index([expiresAt])
  @@map("economic_events")
}

model NewsFilterEvent {
  id             String   @id @default(cuid())
  eventId        String   @unique @map("event_id")
  title          String
  category       String   // CPI, PPI, NFP, FOMC, INTEREST_RATE, SEC, ETF, REGULATORY, CRYPTO_MAJOR, EXCHANGE
  impactLevel    String   @default("MEDIUM") // HIGH, MEDIUM, LOW
  isBlocking     Boolean  @default(false) @map("is_blocking")
  publishedAt    DateTime @map("published_at")
  blockStart     DateTime @map("block_start")
  blockEnd       DateTime @map("block_end")
  source         String
  sourceUrl      String?  @map("source_url")
  metadataJson   String?  @map("metadata_json")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([publishedAt, category, impactLevel])
  @@index([isBlocking])
  @@map("news_filter_events")
}

model PortfolioSnapshot {
  id              String   @id @default(uuid())
  timestamp       DateTime @default(now())
  balance         Float    @default(0)
  equity          Float    @default(0)
  availableMargin Float    @map("available_margin")
  usedMargin      Float    @map("used_margin")
  unrealizedPnL   Float    @default(0) @map("unrealized_pnl")
  realizedPnL     Float    @default(0) @map("realized_pnl")
  totalFees       Float    @default(0) @map("total_fees")
  totalFunding    Float    @default(0) @map("total_funding")
  openPositions   Int      @default(0) @map("open_positions")
  snapshotJson    String?  @map("snapshot_json")
  source          String   @default("DELTA_EXCHANGE") @map("source")

  @@index([timestamp])
  @@map("portfolio_snapshots")
}

model PaperWallet {
  id              String   @id @default("default-paper-wallet")
  virtualBalance  Float    @map("virtual_balance")
  availableMargin Float    @map("available_margin")
  usedMargin      Float    @default(0.0) @map("used_margin")
  realizedPnL     Float    @default(0.0) @map("realized_pnl")
  unrealizedPnL   Float    @default(0.0) @map("unrealized_pnl")
  equity          Float
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("paper_wallets")
}

model PaperRiskConfig {
  id                     String   @id @default("default-paper-risk")
  maxDailyLoss           Float    @map("max_daily_loss")
  maxDrawdownPercent     Float    @map("max_drawdown_percent")
  maxOpenPositions       Int      @default(1) @map("max_open_positions")
  maxRiskPerTradePercent Float    @map("max_risk_per_trade_percent")
  isEmergencyStopActive  Boolean  @default(false) @map("is_emergency_stop_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("paper_risk_configs")
}

model PaperOrder {
  id             String   @id @default(uuid())
  symbol         String
  side           String
  orderType      String   @map("order_type")
  price          Float?
  stopPrice      Float?   @map("stop_price")
  quantity       Float
  filledQuantity Float    @default(0.0) @map("filled_quantity")
  status         String   @default("PENDING")
  stopLoss       Float?   @map("stop_loss")
  takeProfit     Float?   @map("take_profit")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([symbol, status])
  @@map("paper_orders")
}

model PaperPosition {
  id              String   @id @default(uuid())
  symbol          String
  side            String
  entryPrice      Float    @map("entry_price")
  markPrice       Float    @map("mark_price")
  quantity        Float
  notionalValue   Float    @map("notional_value")
  unrealizedPnL   Float    @default(0.0) @map("unrealized_pnl")
  realizedPnL     Float    @default(0.0) @map("realized_pnl")
  leverage        Float
  marginAllocated Float    @map("margin_allocated")
  stopLoss        Float?   @map("stop_loss")
  takeProfit      Float?   @map("take_profit")
  openedAt        DateTime @default(now()) @map("opened_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([symbol])
  @@map("paper_positions")
}

model PaperTradeJournal {
  id           String   @id @default(uuid())
  eventType    String   @map("event_type")
  symbol       String?
  action       String
  details      String
  metadataJson String?  @map("metadata_json")
  timestamp    DateTime @default(now())

  @@index([symbol, eventType])
  @@map("paper_trade_journals")
}

model TradingRuleConfig {
  id                 String   @id @default("default-trading-rules")
  ruleVersion        String   @map("rule_version")
  configVersion      String   @map("config_version")
  supportedPairsJson String   @map("supported_pairs_json")
  supportedTimeframe String   @map("supported_timeframe")
  bonusesJson        String?  @map("bonuses_json")
  riskRulesJson      String?  @map("risk_rules_json")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("trading_rule_configs")
}

model TradingRuleAudit {
  id            String   @id @default(uuid())
  ruleVersion   String   @map("rule_version")
  configVersion String   @map("config_version")
  action        String
  changedBy     String   @map("changed_by")
  payloadJson   String   @map("payload_json")
  timestamp     DateTime @default(now())

  @@map("trading_rule_audits")
}

model ReplaySession {
  id                 String   @id @default(uuid())
  symbol             String
  timeframe          String   @default("1H")
  currentCandleIndex Int      @default(0) @map("current_candle_index")
  totalCandles       Int      @map("total_candles")
  status             String   @default("IDLE")
  speedMultiplier    Float    @default(1.0) @map("speed_multiplier")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("replay_sessions")
}

model ReplayEvent {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  eventType   String   @map("event_type")
  payloadJson String   @map("payload_json")
  timestamp   DateTime @default(now())

  @@index([sessionId, timestamp])
  @@map("replay_events")
}

model BacktestSession {
  id            String   @id @default(uuid())
  symbol        String
  timeframe     String   @default("1H")
  ruleVersion   String   @map("rule_version")
  configVersion String   @map("config_version")
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  status        String   @default("COMPLETED")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("backtest_sessions")
}

model BacktestTrade {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  symbol     String
  side       String
  entryPrice Float    @map("entry_price")
  exitPrice  Float    @map("exit_price")
  quantity   Float
  pnl        Float
  status     String
  timestamp  DateTime @default(now())

  @@index([sessionId, symbol])
  @@map("backtest_trades")
}

model BacktestMetric {
  id            String   @id @default(uuid())
  sessionId     String   @unique @map("session_id")
  totalTrades   Int      @map("total_trades")
  winningTrades Int      @map("winning_trades")
  losingTrades  Int      @map("losing_trades")
  winRate       Float    @map("win_rate")
  lossRate      Float    @map("loss_rate")
  profitFactor  Float    @map("profit_factor")
  averageRR     Float    @map("average_rr")
  netPnL        Float    @map("net_pnl")
  maxDrawdown   Float    @map("max_drawdown")
  bestTradePnL  Float    @map("best_trade_pnl")
  worstTradePnL Float    @map("worst_trade_pnl")
  skippedTrades Int      @map("skipped_trades")
  invalidTrades Int      @map("invalid_trades")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("backtest_metrics")
}

model ExecutionSession {
  id            String   @id @default(uuid())
  mode          String   @map("execution_mode")
  pair          String
  timeframe     String   @default("1H")
  decisionId    String   @map("decision_id")
  ruleVersion   String   @map("rule_version")
  configVersion String   @map("config_version")
  adapter       String   @map("adapter")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([pair, mode])
  @@map("execution_sessions")
}

model ExecutionRequest {
  id             String   @id @default(uuid())
  sessionId      String   @map("session_id")
  idempotencyKey String   @unique @map("idempotency_key")
  decisionId     String   @map("decision_id")
  symbol         String
  side           String
  mode           String   @map("execution_mode")
  ruleVersion    String   @map("rule_version")
  configVersion  String   @map("config_version")
  orderType      String   @map("order_type")
  quantity       Float
  price          Float?
  stopLoss       Float?   @map("stop_loss")
  takeProfit     Float?   @map("take_profit")
  timestamp      DateTime @default(now())

  @@index([sessionId, idempotencyKey])
  @@map("execution_requests")
}

model ExecutionResult {
  id             String   @id @default(uuid())
  requestId      String   @unique @map("request_id")
  sessionId      String   @map("session_id")
