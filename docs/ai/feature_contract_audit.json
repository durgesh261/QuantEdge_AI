{
  "schema_version": "1.0",
  "audit_phase": "Phase G",
  "feature_contract_version": "2.0.0",
  "total_features": 24,
  "onnx_model": "quantedge-ai-v2.onnx",
  "model_input_shape": [null, 24],
  "model_output_shape": [null, 3],
  "causality_invariant": "STRICT_CAUSAL_T_ONLY (No data from T+1 or later permitted in any feature)",
  "features": [
    {
      "index": 0,
      "name": "bos_strength",
      "group": "SMC Structural Features",
      "source": "Internal & Swing Structure Breaks <= T",
      "calculation": "min(1.0, max(0.0, |structure_break_price - close_T| / (close_T * 0.05 + 1.0)))",
      "timeframe": "1h",
      "data_category": "SMC structure",
      "min_timestamp_lookback": "T - 20 bars",
      "max_timestamp_lookback": "T",
      "value_range": [0.0, 1.0],
      "units": "normalized_ratio"
    },
    {
      "index": 1,
      "name": "choch_strength",
      "group": "SMC Structural Features",
      "source": "Change of Character structure break <= T",
      "calculation": "0.85 if break_type == 'choch' else 0.40",
      "timeframe": "1h",
      "data_category": "SMC structure",
      "min_timestamp_lookback": "T - 20 bars",
      "max_timestamp_lookback": "T",
      "value_range": [0.0, 1.0],
      "units": "normalized_confidence"
    },
    {
      "index": 2,
      "name": "order_block_strength",
      "group": "SMC Structural Features",
      "source": "Detected Order Block width and freshness <= T",
      "calculation": "min(1.0, max(0.1, 1.0 - (ob_width / (close_T * 0.05 + 1.0))))",
      "timeframe": "1h",
      "data_category": "Order Block",
      "min_timestamp_lookback": "T - 50 bars",
      "max_timestamp_lookback": "T",
      "value_range": [0.0, 1.0],
      "units": "normalized_score"
    },
    {
      "index": 3,
      "name": "fvg_strength",
      "group": "SMC Structural Features",
      "source": "Fair Value Gap proximity and fill level <= T",
      "calculation": "min(1.0, max(0.0, |close_T - ob.bottom_price| / (ob.top_price - ob.bottom_price + 1.0)))",
      "timeframe": "1h",
      "data_category": "Order Block / FVG",
      "min_timestamp_lookback": "T - 50 bars",
      "max_timestamp_lookback": "T",
      "value_range": [0.0, 1.0],
      "units": "normalized_ratio"
    },
    {
      "index": 4,
      "name": "liquidity_proximity",
      "group": "SMC Structural Features",
      "source": "Distance to nearest swing/internal pivot high or low <= T",
      "calculation": "min(1.0, max(0.0, 1.0 - (min_pivot_dist / (close_T * 0.05 + 1.0))))",
      "timeframe": "1h",
      "data_category": "Liquidity",
      "min_timestamp_lookback": "T - 30 bars",
      "max_timestamp_lookback": "T",
      "value_range": [0.0, 1.0],
      "units": "normalized_proximity"
    },
    {
      "index": 5,
      "name": "trend_strength_1h",
      "group": "Market Context Features",
      "source": "1H Price slope over 15 bars <= T",
      "calculation": "min(1.0, max(0.0, 0.5 + (close_T - close_{T-15}) / (close_T * 0.03 + 1e-6)))",
      "timeframe": "1h",
      "data_category": "trend",
      "min_timestamp_lookback": "T - 15 bars",
      "max_timestamp_lookback": "T",
      "value_range": [0.0, 1.0],
      "units": "normalized_slope"
    },
    {
      "index": 6,
      "name": "trend_strength_15m",
      "group": "Market Context Features",
      "source": "Short-window price slope over 5 bars <= T",
      "calculation": "min(1.0, max(0.0, 0.5 + (close_T - close_{T-5}) / (close_T * 0.015 + 1e-6)))",
      "timeframe": "1h (short window equivalent)",
      "data_category": "trend",
      "min_timestamp_lookback": "T - 5 bars",
      "max_timestamp_lookback": "T",
      "value_range": [0.0, 1.0],
      "units": "normalized_slope"
    },
    {
      "index": 7,
      "name": "trend_strength_4h",
      "group": "Market Context Features",
      "source": "Longer-window price slope over 50 bars <= T",
      "calculation": "min(1.0, max(0.0, 0.5 + (close_T - close_{T-50}) / (close_T * 0.06 + 1e-6)))",
      "timeframe": "1h (multi-period equivalent)",
      "data_category": "trend",
      "min_timestamp_lookback": "T - 50 bars",
      "max_timestamp_lookback": "T",
      "value_range": [0.0, 1.0],
      "units": "normalized_slope"
    },
    {
      "index": 8,
      "name": "volatility_1h",
      "group": "Market Context Features",
      "source": "14-period Wilder smoothed ATR normalized to close price <= T",
      "calculation": "min(1.0, max(0.0, atr_14 / (close_T * 0.03 + 1e-6)))",
      "timeframe": "1h",
      "data_category": "volatility",
      "min_timestamp_lookback": "T - 14 bars",
      "max_timestamp_lookback": "T",
      "value_range": [0.0, 1.0],
      "units": "normalized_atr"
    },
    {
      "index": 9,
      "name": "volatility_15m",
      "group": "Market Context Features",
      "source": "5-period high-low range average normalized to close price <= T",
      "calculation": "min(1.0, max(0.0, avg_range_5 / (close_T * 0.02 + 1e-6)))",
      "timeframe": "1h (short window equivalent)",
      "data_category": "volatility",
      "min_timestamp_lookback": "T - 5 bars",
      "max_timestamp_lookback": "T",
      "value_range": [0.0, 1.0],
      "units": "normalized_range"
    },
    {
      "index": 10,
      "name": "volume_profile",
      "group": "Market Context Features",
      "source": "Recent (5-period) vs Historical (30-period) volume ratio <= T",
      "calculation": "clip(avg_recent_vol_5 / (avg_hist_vol_30 + 1e-6), 0.0, 2.0)",
      "timeframe": "1h",
      "data_category": "volume",
      "min_timestamp_lookback": "T - 30 bars",
      "max_timestamp_lookback": "T",
      "value_range": [0.0, 2.0],
      "units": "volume_ratio"
    },
    {
      "index": 11,
      "name": "momentum_1h",
      "group": "Market Context Features",
      "source": "10-period rate of change <= T",
      "calculation": "clip((close_T - close_{T-10}) / (close_{T-10} + 1e-6), -0.5, 0.5)",
      "timeframe": "1h",
      "data_category": "momentum",
      "min_timestamp_lookback": "T - 10 bars",
      "max_timestamp_lookback": "T",
      "value_range": [-0.5, 0.5],
      "units": "rate_of_change"
    },
    {
      "index": 12,
      "name": "momentum_15m",
      "group": "Market Context Features",
      "source": "3-period rate of change <= T",
      "calculation": "clip((close_T - close_{T-3}) / (close_{T-3} + 1e-6), -0.5, 0.5)",
      "timeframe": "1h (short window equivalent)",
      "data_category": "momentum",
      "min_timestamp_lookback": "T - 3 bars",
      "max_timestamp_lookback": "T",
      "value_range": [-0.5, 0.5],
      "units": "rate_of_change"
    },
    {
      "index": 13,
      "name": "risk_reward",
      "group": "Setup Geometry Features",
      "source": "Target Reward distance divided by Risk distance at entry T",
      "calculation": "|take_profit - entry| / |entry - stop_loss|",
      "timeframe": "1h",
      "data_category": "risk",
      "min_timestamp_lookback": "T",
      "max_timestamp_lookback": "T",
      "value_range": [0.0, 50.0],
      "units": "rr_ratio"
    },
    {
      "index": 14,
      "name": "risk_distance",
      "group": "Setup Geometry Features",
      "source": "Stop loss distance in price units at entry T",
      "calculation": "|entry - stop_loss|",
      "timeframe": "1h",
      "data_category": "risk",
      "min_timestamp_lookback": "T",
      "max_timestamp_lookback": "T",
      "value_range": [0.0, 100000.0],
      "units": "price_units"
    },
    {
      "index": 15,
      "name": "entry_precision",
      "group": "Setup Geometry Features",
      "source": "Proximity of entry price to Order Block edge at T",
      "calculation": "min(1.0, max(0.0, 1.0 - |close_T - ob_edge| / (ob_span + 1e-6)))",
      "timeframe": "1h",
      "data_category": "Order Block geometry",
      "min_timestamp_lookback": "T",
      "max_timestamp_lookback": "T",
      "value_range": [0.0, 1.0],
      "units": "normalized_precision"
    },
    {
      "index": 16,
      "name": "account_utilization",
      "group": "Account & Risk Context",
      "source": "Allocated margin fraction",
      "calculation": "margin_used / total_equity (default 0.20 for model training)",
      "timeframe": "1h",
      "data_category": "account",
      "min_timestamp_lookback": "T",
      "max_timestamp_lookback": "T",
      "value_range": [0.0, 1.0],
      "units": "fraction"
    },
    {
      "index": 17,
      "name": "leverage_ratio",
      "group": "Account & Risk Context",
      "source": "Setup leverage normalized to maximum allowed leverage (100x)",
      "calculation": "leverage / 100.0",
      "timeframe": "1h",
      "data_category": "risk",
      "min_timestamp_lookback": "T",
      "max_timestamp_lookback": "T",
      "value_range": [0.01, 1.0],
      "units": "fraction"
    },
    {
      "index": 18,
      "name": "regime_1h_bullish",
      "group": "1H Regime One-Hot Encoding",
      "source": "One-hot class indicator for TRENDING_BULLISH (trend_1h >= 0.60)",
      "calculation": "1.0 if regime == 'TRENDING_BULLISH' else 0.0",
      "timeframe": "1h",
      "data_category": "one-hot",
      "min_timestamp_lookback": "T - 15 bars",
      "max_timestamp_lookback": "T",
      "value_range": [0.0, 1.0],
      "units": "binary_flag"
    },
    {
      "index": 19,
      "name": "regime_1h_bearish",
      "group": "1H Regime One-Hot Encoding",
      "source": "One-hot class indicator for TRENDING_BEARISH (trend_1h <= 0.40)",
      "calculation": "1.0 if regime == 'TRENDING_BEARISH' else 0.0",
      "timeframe": "1h",
      "data_category": "one-hot",
      "min_timestamp_lookback": "T - 15 bars",
      "max_timestamp_lookback": "T",
      "value_range": [0.0, 1.0],
      "units": "binary_flag"
    },
    {
      "index": 20,
      "name": "regime_1h_ranging",
      "group": "1H Regime One-Hot Encoding",
      "source": "One-hot class indicator for RANGING (vol_1h < 0.20)",
      "calculation": "1.0 if regime == 'RANGING' else 0.0",
      "timeframe": "1h",
      "data_category": "one-hot",
      "min_timestamp_lookback": "T - 15 bars",
      "max_timestamp_lookback": "T",
      "value_range": [0.0, 1.0],
      "units": "binary_flag"
    },
    {
      "index": 21,
      "name": "regime_1h_transitional",
      "group": "1H Regime One-Hot Encoding",
      "source": "One-hot class indicator for TRANSITIONAL",
      "calculation": "1.0 if regime == 'TRANSITIONAL' else 0.0",
      "timeframe": "1h",
      "data_category": "one-hot",
      "min_timestamp_lookback": "T - 15 bars",
      "max_timestamp_lookback": "T",
      "value_range": [0.0, 1.0],
      "units": "binary_flag"
    },
    {
      "index": 22,
      "name": "regime_alignment",
      "group": "Binary Flags",
      "source": "Multi-lookback trend alignment indicator",
      "calculation": "1.0 if (trend_1h >= 0.5 and trend_4h >= 0.5) or (trend_1h < 0.5 and trend_4h < 0.5) else 0.0",
      "timeframe": "1h",
      "data_category": "binary",
      "min_timestamp_lookback": "T - 50 bars",
      "max_timestamp_lookback": "T",
      "value_range": [0.0, 1.0],
      "units": "binary_flag"
    },
    {
      "index": 23,
      "name": "direction_long",
      "group": "Binary Flags",
      "source": "Setup order direction flag",
      "calculation": "1.0 if direction in ('LONG', 'BUY') else 0.0",
      "timeframe": "1h",
      "data_category": "binary",
      "min_timestamp_lookback": "T",
      "max_timestamp_lookback": "T",
      "value_range": [0.0, 1.0],
      "units": "binary_flag"
    }
  ]
}
