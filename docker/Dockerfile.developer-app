# Developer App Dockerfile - Multi-stage build
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY developer-app/package*.json ./
COPY developer-app/tsconfig*.json ./
COPY developer-app/vite.config.ts ./
COPY developer-app/tailwind.config.js ./
COPY developer-app/postcss.config.js ./
COPY developer-app/index.html ./

# Install dependencies
RUN npm ci

# Copy source
COPY developer-app/src ./src

# Build
RUN npm run build

# Production stage
FROM nginx:alpine AS production

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx config
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
