# User App Dockerfile - Multi-stage build
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY user-app/package*.json ./
COPY user-app/tsconfig*.json ./
COPY user-app/vite.config.ts ./
COPY user-app/tailwind.config.js ./
COPY user-app/postcss.config.js ./
COPY user-app/index.html ./

# Install dependencies
RUN npm ci

# Copy source
COPY user-app/src ./src
COPY user-app/public ./public

# Build
RUN npm run build

# Production stage
FROM nginx:alpine AS production

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx config
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
