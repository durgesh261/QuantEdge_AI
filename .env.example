# Environment Mode (development | testing | sandbox | production)
NODE_ENV=production
PORT=4000

# Database Persistence
# The database file is stored relative to the backend/prisma/ directory
DATABASE_URL="file:./quantedge.db"

# Security Credentials
TRADINGVIEW_WEBHOOK_SECRET=your_tradingview_webhook_secret_here

# Delta Exchange API Keys (Required ONLY for Live Execution)
# Obtain from: https://www.delta.exchange/app/account/manageapikeys
DELTA_API_KEY=your_delta_api_key_here
DELTA_API_SECRET=your_delta_api_secret_here
DELTA_ENVIRONMENT=PRODUCTION
NOTIFICATIONS_ENABLED=false
NOTIFICATION_TIMEOUT_MS=5000
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_BACKOFF_MS=1000
NOTIFICATION_COOLDOWN_MS=300000
