# QuantEdge AI V2 - Environment Variables
# Copy to .env and fill in values

# ===========================================
# JWT Secret (MINIMUM 256 bits / 32 chars)
# Generate with: openssl rand -base64 32
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-min-256-bits-change-in-production

# ===========================================
# Frontend
# ===========================================
VITE_API_URL=http://localhost:8080/api

# ===========================================
# Delta Exchange Credentials (Optional - per user in production)
# ===========================================
DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_TESTNET_API_KEY=
DELTA_TESTNET_API_SECRET=

# ===========================================
# Python Engine
# ===========================================
PYTHON_ENGINE_URL=http://localhost:8000
PYTHON_ENGINE_API_KEY=

# ===========================================
# Backend API Key (for Python -> Backend communication)
# ===========================================
BACKEND_API_KEY=

# ===========================================
# Database (Development - docker-compose handles this)
# ===========================================
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/quantedge
# SPRING_DATASOURCE_USERNAME=quantedge
# SPRING_DATASOURCE_PASSWORD=quantedge_dev

# ===========================================
# CORS
# ===========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000