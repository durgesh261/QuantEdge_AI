# QuantEdge AI - Production Environment Template
# Copy this template to .env for local runtime or deployment orchestration.
# All exchange credentials are per-user encrypted at rest in the database.

# ==============================================================================
# Security & JWT (Required in production)
# Generate with: openssl rand -base64 32
# ==============================================================================
JWT_SECRET=your-super-secret-jwt-key-min-256-bits-change-in-production

# ==============================================================================
# AES-256 Master Encryption Key (For user-specific Delta API credentials at rest)
# Generate with: openssl rand -base64 32
# NOTE: Must remain identical across restarts to decrypt stored user credentials.
# ==============================================================================
ENCRYPTION_KEY=your-aes-256-master-key-base64-change-in-production

# ==============================================================================
# Service Endpoints & Communication
# ==============================================================================
VITE_API_URL=http://localhost:8080/api
PYTHON_ENGINE_URL=http://localhost:8000
PYTHON_ENGINE_API_KEY=
BACKEND_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:3101

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/quantedge
SPRING_DATASOURCE_USERNAME=quantedge
SPRING_DATASOURCE_PASSWORD=quantedge_dev
DB_POOL_SIZE=20

# ==============================================================================
# External Live Intelligence Feeds (Phase 8.2)
# ==============================================================================
NEWS_PROVIDER_MODE=external
NEWS_PROVIDER_BASE_URL=https://min-api.cryptocompare.com/data/v2/news/?lang=EN
NEWS_PROVIDER_API_KEY=
ECONOMIC_PROVIDER_MODE=external
ECONOMIC_PROVIDER_BASE_URL=https://nfs.faireconomy.media/
ECONOMIC_PROVIDER_API_KEY=

# ==============================================================================
# Local CLI / Diagnostics Tooling (Optional - Local Developer Environment Only)
# In production, exchange credentials are submitted per-user via frontend UI,
# encrypted via AES-256, and stored per TradingAccount in PostgreSQL.
# ==============================================================================
# DELTA_API_KEY=
# DELTA_API_SECRET=

# ==============================================================================
# Developer / Operator Console Credentials
# These are used only by DeveloperAccountInitializer at first application startup.
# Change the password after the first login — the initializer skips if account exists.
# ==============================================================================
DEVELOPER_EMAIL=developer@your-domain.com
DEVELOPER_INITIAL_PASSWORD=change-me-on-first-login

# ==============================================================================
# SMTP Email Delivery (for password reset emails)
# Leave MAIL_HOST blank in development — set MAIL_DEV_LOG_ENABLED=true to log
# the reset URL to the application log instead of delivering a real email.
# In production: configure with your transactional email provider.
# ==============================================================================
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@your-domain.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# Enable dev-log mode ONLY in development (logs reset URL to application log):
MAIL_DEV_LOG_ENABLED=false

# ==============================================================================
# Password Reset
# ==============================================================================
PASSWORD_RESET_BASE_URL=http://localhost:3100