# Environment Mode (development | testing | sandbox | production)
NODE_ENV=production
PORT=4000

# Database Persistence
# The database file is stored relative to the backend/prisma/ directory
# For development: DATABASE_URL="file:./prisma/dev.db"
# For production: Set DATABASE_URL via your hosting platform environment variable
# Run migrations: npm run prisma:migrate (first time creates the initial migration)

# Security Credentials
# Replace with actual values or set via environment hosting platform
TRADINGVIEW_WEBHOOK_SECRET=your_tradingview_webhook_secret_here

# Delta Exchange API Keys (Required ONLY for Live Execution)
# Obtain from: https://www.delta.exchange/app/account/manageapikeys
# These should be set via environment variables in production, NOT committed to source control
DELTA_API_KEY=your_delta_api_key_here
DELTA_API_SECRET=your_delta_api_secret_here
DELTA_ENVIRONMENT=PRODUCTION

# Authentication
# Set a secret token for API authentication in production.
# The frontend must provide this token as a Bearer token in the Authorization header.
# Generate a random string for production and store it securely in your hosting environment.
AUTH_TOKEN=your_auth_token_here
